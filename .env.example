# Copy to .env (run.sh / run.bat do this for you). Every value below is the default; delete or edit freely.

# ---- Hugging Face (only needed for IndicTrans2, which is a "gated" model) --------------------------
# 1) create a free account at huggingface.co
# 2) open each model page below while logged in and click "Agree and access repository":
#      ai4bharat/indictrans2-en-indic-dist-200M
#      ai4bharat/indictrans2-indic-en-dist-200M
#      ai4bharat/indictrans2-indic-indic-dist-320M
# 3) create a READ token at huggingface.co/settings/tokens and paste it here (or run `lingua login`)
# Without this, translation still works through NLLB (lower quality, especially for Sanskrit).
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HF_HOME=D:\models        # where models are stored (default: your user cache folder)

# ---- Models and hardware ---------------------------------------------------------------------------
# small = 200M/320M IndicTrans2 + NLLB-600M (about 6 GB of downloads, fits a 4 GB GPU)
# base  = 1B IndicTrans2 + NLLB-1.3B       (about 19 GB, wants 8 GB+ of VRAM)
LB_PROFILE=small
LB_DEVICE=auto               # auto | cuda | cpu
LB_DTYPE=auto                # auto (float16 on GPU, float32 on CPU) | float32 | float16 | bfloat16
LB_MAX_LOADED_MODELS=2       # models kept in memory at once; lower it if your GPU runs out of memory

# ---- Translation behaviour -------------------------------------------------------------------------
# auto = IndicTrans2 for Sanskrit/Hindi/English, NLLB for Chinese.  nllb = NLLB for everything.
LB_TRANSLATION_ENGINE=auto
# If an IndicTrans2 model is gated and you are not logged in, use NLLB for that step and say so.
LB_FALLBACK_TO_NLLB=true
LB_NUM_BEAMS=4
LB_MAX_NEW_TOKENS=256
LB_BATCH_SIZE=8
LB_MAX_INPUT_CHARS=5000
# Per-pair routing, e.g. force direct Sanskrit->Chinese or use opus-mt for English<->Chinese:
# LB_ROUTE_OVERRIDES={"sa>zh": "direct", "en>zh": "opus", "zh>en": "opus"}

# ---- Conversion ------------------------------------------------------------------------------------
LB_HINGLISH_BACKEND=auto     # auto | rule | ai4bharat

# ---- Server ----------------------------------------------------------------------------------------
LB_HOST=127.0.0.1            # 0.0.0.0 makes it reachable from other machines on your network
LB_PORT=8000
LB_LOG_LEVEL=INFO
